    "start": "retro-museum-host --package dist/game.rmg.json",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@manaty/retro-museum-sdk": "https://github.com/manaty/retro-museum-sdk/archive/fe1dad4bcfdb0b07840e55267d19cc947227c710.tar.gz",
    "three": "0.185.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22"
  }
}
