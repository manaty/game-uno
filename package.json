{
  "name": "@manaty/game-uno",
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Play UNO · Color party together on a shared screen, using phones as controllers. 2–7 players.",
  "exports": {
    "./engine": "./server/uno.js",
    "./package": "./dist/game.rmg.json",
    "./public/*": "./public/*"
  },
  "scripts": {
